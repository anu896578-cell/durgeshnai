 <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Durgersh Nai — Login & Book</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --gold: #c8a96e;
  --gold-light: #e8d9b8;
  --gold-dim: rgba(200,169,110,0.18);
  --dark:  #0d0d18;
  --dark2: #12121f;
  --dark3: #1a1a2e;
  --surface: rgba(255,255,255,0.04);
  --border: rgba(255,255,255,0.09);
  --text: #f4efe6;
  --muted: rgba(244,239,230,0.42);
  --green: #5dcaa5;
  --red: #e06b6b;
  --r: 14px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

body{
  background:var(--dark);
  color:var(--text);
  font-family:'DM Sans',sans-serif;
  font-weight:300;
  min-height:100vh;
  overflow-x:hidden;
}

body::before{
  content:'';position:fixed;inset:0;
  background:
    radial-gradient(ellipse 70% 55% at 15% 25%,rgba(200,169,110,0.07) 0%,transparent 65%),
    radial-gradient(ellipse 55% 45% at 85% 75%,rgba(80,50,120,0.09) 0%,transparent 65%);
  pointer-events:none;z-index:0;
}

nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:1rem 2.5rem;
  background:rgba(13,13,24,0.88);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.logo{
  font-family:'Cormorant Garamond',serif;
  font-size:22px;font-weight:700;
  color:var(--gold);text-decoration:none;letter-spacing:.04em;cursor:pointer;
}
.nav-right{display:flex;align-items:center;gap:12px;}
.nav-tag{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
#navLoginBtn,#navLogoutBtn{
  padding:7px 18px;border-radius:30px;font-size:12px;font-weight:500;
  letter-spacing:.06em;text-transform:uppercase;cursor:pointer;
  font-family:'DM Sans',sans-serif;border:1px solid rgba(200,169,110,.35);
  color:var(--gold);background:transparent;transition:background .2s;
}
#navLoginBtn:hover,#navLogoutBtn:hover{background:rgba(200,169,110,.08);}
#navLogoutBtn{display:none;}

.pg{
  position:relative;z-index:1;
  min-height:100vh;display:none;padding-top:70px;
}
.pg.active{display:flex;}

/* ══ LOGIN ══ */
#pgLogin{align-items:stretch;}

.login-left{
  flex:1;display:flex;flex-direction:column;justify-content:center;
  padding:5rem 4rem 5rem 5rem;
  border-right:1px solid var(--border);
  min-height:calc(100vh - 70px);
}
.login-right{
  width:420px;flex-shrink:0;
  display:flex;flex-direction:column;justify-content:center;
  padding:4rem 3.5rem;
}

.login-eyebrow{
  display:inline-block;font-size:11px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--gold);margin-bottom:1rem;
  padding:3px 12px;border:1px solid rgba(200,169,110,.28);border-radius:20px;
}
.login-left h1{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(40px,5vw,64px);font-weight:700;line-height:1.05;margin-bottom:1.25rem;
}
.login-left h1 em{color:var(--gold);font-style:italic;}
.login-left p{font-size:15px;color:var(--muted);line-height:1.75;max-width:380px;margin-bottom:2.5rem;}
.perks{display:flex;flex-direction:column;gap:12px;}
.perk{display:flex;align-items:center;gap:12px;font-size:14px;color:var(--muted);}
.perk-dot{
  width:28px;height:28px;border-radius:50%;flex-shrink:0;
  background:var(--gold-dim);border:1px solid rgba(200,169,110,.3);
  display:flex;align-items:center;justify-content:center;font-size:13px;
}

.form-head{margin-bottom:2rem;}
.form-head h2{font-family:'Cormorant Garamond',serif;font-size:30px;font-weight:700;margin-bottom:.35rem;}
.form-head p{font-size:13px;color:var(--muted);}
.form-head p a{color:var(--gold);text-decoration:none;cursor:pointer;}
.form-head p a:hover{text-decoration:underline;}

.tab-bar{
  display:flex;gap:0;margin-bottom:2rem;
  border:1px solid var(--border);border-radius:10px;
  overflow:hidden;padding:3px;background:var(--surface);
}
.tab-btn{
  flex:1;padding:9px;border:none;background:transparent;
  font-family:'DM Sans',sans-serif;font-size:13px;color:var(--muted);
  cursor:pointer;border-radius:8px;transition:all .2s;
}
.tab-btn.active{background:rgba(200,169,110,.15);color:var(--gold-light);font-weight:500;}

.fld{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
.fld label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
.fld input{
  background:rgba(255,255,255,.04);border:1px solid var(--border);
  border-radius:10px;color:var(--text);font-family:'DM Sans',sans-serif;
  font-size:14px;font-weight:300;padding:11px 14px;outline:none;
  transition:border-color .2s;width:100%;
}
.fld input::placeholder{color:var(--muted);}
.fld input:focus{border-color:rgba(200,169,110,.5);}
.fld-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}

.forgot{
  text-align:right;font-size:12px;color:var(--gold);
  cursor:pointer;display:block;margin-top:-8px;margin-bottom:14px;
}
.forgot:hover{text-decoration:underline;}

.err-msg{
  font-size:13px;color:var(--red);margin-bottom:12px;
  padding:9px 12px;border-radius:8px;
  background:rgba(224,107,107,.08);border:1px solid rgba(224,107,107,.2);display:none;
}
.err-msg.show{display:block;}

.primary-btn{
  width:100%;padding:13px;border-radius:var(--r);
  background:var(--gold);color:var(--dark);
  font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;
  letter-spacing:.04em;border:none;cursor:pointer;
  transition:opacity .2s,transform .15s;margin-bottom:14px;
}
.primary-btn:hover{opacity:.87;transform:translateY(-2px);}
.primary-btn:active{transform:scale(.98);}

.divider-or{
  display:flex;align-items:center;gap:12px;
  font-size:12px;color:var(--muted);margin-bottom:14px;
}
.divider-or::before,.divider-or::after{content:'';flex:1;height:1px;background:var(--border);}

.social-btn{
  width:100%;padding:11px;border-radius:10px;
  border:1px solid var(--border);background:var(--surface);
  color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:border-color .2s,background .2s;
}
.social-btn:hover{border-color:rgba(200,169,110,.3);background:rgba(200,169,110,.04);}
.social-icon{width:18px;height:18px;flex-shrink:0;}

/* ══ BOOKING ══ */
#pgBook{flex-direction:column;align-items:center;padding:4.5rem 1.5rem 5rem;}

.bk-header{text-align:center;margin-bottom:2.75rem;animation:fadeUp .6s ease both;}
.bk-eyebrow{
  display:inline-block;font-size:11px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--gold);margin-bottom:.9rem;
  padding:3px 12px;border:1px solid rgba(200,169,110,.28);border-radius:20px;
}
.bk-header h1{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(34px,5vw,52px);font-weight:700;line-height:1.1;margin-bottom:.6rem;
}
.bk-header p{font-size:15px;color:var(--muted);max-width:340px;margin:0 auto;line-height:1.7;}

.steps{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:2.5rem;animation:fadeUp .6s .1s ease both;}
.step{display:flex;flex-direction:column;align-items:center;gap:6px;}
.step-num{
  width:36px;height:36px;border-radius:50%;
  border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:500;color:var(--muted);background:var(--dark2);transition:all .3s;
}
.step.active .step-num{border-color:var(--gold);color:var(--dark);background:var(--gold);}
.step.done .step-num{border-color:var(--gold);background:transparent;color:var(--gold);}
.step-label{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);white-space:nowrap;}
.step.active .step-label{color:var(--gold);}
.step-line{width:55px;height:1px;background:var(--border);margin:0 6px;margin-bottom:22px;}

.panel{
  width:100%;max-width:860px;
  background:var(--surface);border:1px solid var(--border);
  border-radius:20px;padding:2rem;
  animation:fadeUp .6s .15s ease both;backdrop-filter:blur(8px);
}

.sec-label{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:1.25rem;}

.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:12px;margin-bottom:2.5rem;}
.svc-card{
  border:1px solid var(--border);border-radius:var(--r);
  padding:1.1rem;cursor:pointer;background:transparent;
  transition:border-color .2s,background .2s,transform .15s;position:relative;
}
.svc-card:hover{border-color:rgba(200,169,110,.35);background:rgba(200,169,110,.04);transform:translateY(-2px);}
.svc-card.sel{border-color:var(--gold);background:rgba(200,169,110,.07);}
.svc-card.sel::after{content:'✓';position:absolute;top:10px;right:12px;font-size:12px;color:var(--gold);font-weight:600;}
.svc-name{font-weight:500;font-size:14px;color:var(--text);margin-bottom:4px;}
.svc-desc{font-size:12px;color:var(--muted);margin-bottom:10px;line-height:1.5;}
.svc-meta{display:flex;justify-content:space-between;align-items:center;}
.svc-price{font-size:15px;font-weight:500;color:var(--gold);}
.svc-dur{font-size:11px;color:var(--muted);}

.sec-div{height:1px;background:var(--border);margin:1.75rem 0;}

.date-row{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;margin-bottom:1.75rem;scrollbar-width:none;}
.date-row::-webkit-scrollbar{display:none;}
.date-chip{
  flex-shrink:0;display:flex;flex-direction:column;align-items:center;
  padding:10px 16px;border:1px solid var(--border);border-radius:var(--r);
  cursor:pointer;background:transparent;transition:all .2s;min-width:60px;
}
.date-chip:hover{border-color:rgba(200,169,110,.35);background:rgba(200,169,110,.04);}
.date-chip.sel{border-color:var(--gold);background:rgba(200,169,110,.08);}
.date-chip.today .d-name{color:var(--gold);}
.d-name{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px;}
.d-num{font-size:18px;font-weight:500;color:var(--text);font-family:'Cormorant Garamond',serif;}

.time-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:1.75rem;}
.t-chip{
  padding:7px 14px;border:1px solid var(--border);border-radius:8px;
  font-size:13px;cursor:pointer;color:var(--text);background:transparent;transition:all .2s;
}
.t-chip:hover:not(.bkd){border-color:rgba(200,169,110,.35);background:rgba(200,169,110,.04);}
.t-chip.sel{border-color:var(--gold);background:rgba(200,169,110,.1);color:var(--gold-light);}
.t-chip.bkd{opacity:.25;cursor:not-allowed;text-decoration:line-through;}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:1.5rem;}
.form-fld{display:flex;flex-direction:column;gap:6px;}
.form-fld.full{grid-column:1/-1;}
.form-fld label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
.form-fld input,.form-fld select,.form-fld textarea{
  background:rgba(255,255,255,.04);border:1px solid var(--border);
  border-radius:10px;color:var(--text);font-family:'DM Sans',sans-serif;
  font-size:14px;font-weight:300;padding:11px 14px;outline:none;
  transition:border-color .2s;width:100%;
}
.form-fld input::placeholder,.form-fld textarea::placeholder{color:var(--muted);}
.form-fld input:focus,.form-fld select:focus,.form-fld textarea:focus{border-color:rgba(200,169,110,.5);}
.form-fld select option{background:#1c1c35;}
.form-fld textarea{resize:vertical;min-height:80px;}

.sum-box{
  background:rgba(200,169,110,.05);border:1px solid rgba(200,169,110,.2);
  border-radius:var(--r);padding:1.25rem 1.5rem;margin-bottom:1.75rem;display:none;
}
.sum-box.vis{display:block;}
.sum-row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:8px;}
.sum-row span:last-child{color:var(--text);font-weight:500;}
.sum-total{
  display:flex;justify-content:space-between;font-size:15px;
  color:var(--gold-light);font-weight:500;
  border-top:1px solid rgba(200,169,110,.15);padding-top:12px;margin-top:12px;
}

.confirm-btn{
  width:100%;padding:14px;border-radius:var(--r);
  background:var(--gold);color:var(--dark);
  font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;
  letter-spacing:.04em;border:none;cursor:pointer;
  transition:opacity .2s,transform .15s;
}
.confirm-btn:hover{opacity:.87;transform:translateY(-2px);}
.confirm-btn:active{transform:scale(.98);}

.user-bar{
  width:100%;max-width:860px;
  display:none;align-items:center;justify-content:space-between;
  padding:10px 18px;background:rgba(200,169,110,.06);
  border:1px solid rgba(200,169,110,.18);border-radius:10px;
  margin-bottom:1.5rem;font-size:13px;color:var(--muted);
  animation:fadeUp .4s ease both;
}
.user-bar.vis{display:flex;}
.user-bar strong{color:var(--gold-light);}

.success-screen{display:none;text-align:center;padding:3.5rem 2rem;animation:fadeUp .5s ease both;}
.success-screen.vis{display:block;}
.chk{
  width:72px;height:72px;border-radius:50%;
  background:rgba(93,202,165,.1);border:1px solid rgba(93,202,165,.35);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 1.5rem;font-size:28px;
}
.success-screen h2{font-family:'Cormorant Garamond',serif;font-size:32px;margin-bottom:.5rem;}
.success-screen p{color:var(--muted);font-size:14px;line-height:1.7;max-width:320px;margin:0 auto 2rem;}
.ghost-btn{
  display:inline-block;padding:11px 28px;border-radius:30px;
  border:1px solid rgba(200,169,110,.35);color:var(--gold);font-size:13px;
  cursor:pointer;background:transparent;font-family:'DM Sans',sans-serif;transition:background .2s;
}
.ghost-btn:hover{background:rgba(200,169,110,.08);}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

@media(max-width:780px){
  .login-left{display:none;}
  .login-right{width:100%;padding:3rem 1.5rem;}
  nav{padding:1rem 1.25rem;}
  .form-grid{grid-template-columns:1fr;}
  .form-fld.full{grid-column:1;}
  .step-line{width:28px;}
  .panel{padding:1.5rem 1.25rem;}
}
</style>
</head>
<body>

<nav>
  <span class="logo" onclick="goTo('login')">Durgersh Nai</span>
  <div class="nav-right">
    <span class="nav-tag">Est. 2010 · Jaipur</span>
    <button id="navLoginBtn" onclick="goTo('login')">Login</button>
    <button id="navLogoutBtn" onclick="logout()">Logout</button>
  </div>
</nav>

<!-- ══ LOGIN PAGE ══ -->
<div class="pg" id="pgLogin">
  <div class="login-left">
    <span class="login-eyebrow">Premium Barbershop</span>
    <h1>Look sharp,<br><em>feel sharper.</em></h1>
    <p>Join Durgersh Nai's members to book appointments instantly, track your style history, and get exclusive offers.</p>
    <div class="perks">
      <div class="perk"><div class="perk-dot">✂</div>Instant online booking, no waiting calls</div>
      <div class="perk"><div class="perk-dot">★</div>Member-only discounts every month</div>
      <div class="perk"><div class="perk-dot">◎</div>Style history and barber preferences saved</div>
      <div class="perk"><div class="perk-dot">🔔</div>SMS reminders before your appointment</div>
    </div>
  </div>

  <div class="login-right">
    <div class="form-head">
      <h2 id="formTitle">Welcome back</h2>
      <p id="formSub">New here? <a onclick="switchTab('signup')">Create an account</a></p>
    </div>

    <div class="tab-bar">
      <button class="tab-btn active" id="tabLogin" onclick="switchTab('login')">Sign in</button>
      <button class="tab-btn" id="tabSignup" onclick="switchTab('signup')">Register</button>
    </div>

    <!-- Sign in -->
    <div id="loginForm">
      <div class="fld">
        <label>Phone / Email</label>
        <input type="text" id="loginId" placeholder="raj@email.com or 9876543210">
      </div>
      <div class="fld">
        <label>Password</label>
        <input type="password" id="loginPw" placeholder="••••••••">
      </div>
      <span class="forgot">Forgot password?</span>
      <div class="err-msg" id="loginErr">Incorrect credentials. Hint: raj@email.com / 1234</div>
      <button class="primary-btn" onclick="doLogin()">Sign in →</button>
      <div class="divider-or">or continue with</div>
      <button class="social-btn" onclick="guestLogin()">
        <svg class="social-icon" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Continue with Google
      </button>
    </div>

    <!-- Register -->
    <div id="signupForm" style="display:none;">
      <div class="fld-row">
        <div class="fld"><label>First name</label><input type="text" id="sgFirst" placeholder="Raj"></div>
        <div class="fld"><label>Last name</label><input type="text" id="sgLast" placeholder="Sharma"></div>
      </div>
      <div class="fld"><label>Email</label><input type="email" id="sgEmail" placeholder="raj@email.com"></div>
      <div class="fld"><label>Phone</label><input type="tel" id="sgPhone" placeholder="+91 98765 43210"></div>
      <div class="fld"><label>Password</label><input type="password" id="sgPw" placeholder="Min 6 characters"></div>
      <div class="err-msg" id="signupErr">Please fill all fields.</div>
      <button class="primary-btn" onclick="doSignup()">Create Account →</button>
      <div class="divider-or">or</div>
      <button class="social-btn" onclick="guestLogin()">
        <svg class="social-icon" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Sign up with Google
      </button>
    </div>
  </div>
</div>

<!-- ══ BOOKING PAGE ══ -->
<div class="pg" id="pgBook">

  <div class="bk-header">
    <span class="bk-eyebrow">Online Booking</span>
    <h1>Reserve Your Chair</h1>
    <p>Pick your style, choose a time, and we'll have you looking sharp.</p>
  </div>

  <div class="user-bar" id="userBar">
    <span>Welcome back, <strong id="userNameDisplay">—</strong> 👋</span>
    <span style="font-size:12px;">Your details are pre-filled below.</span>
  </div>

  <div class="steps" id="stepRow">
    <div class="step active" id="s1"><div class="step-num">1</div><span class="step-label">Service</span></div>
    <div class="step-line"></div>
    <div class="step" id="s2"><div class="step-num">2</div><span class="step-label">Time</span></div>
    <div class="step-line"></div>
    <div class="step" id="s3"><div class="step-num">3</div><span class="step-label">Details</span></div>
  </div>

  <div class="panel" id="bookPanel">

    <p class="sec-label">Choose a service</p>
    <div class="svc-grid">
      <div class="svc-card" onclick="pickSvc(this,'Low Fade Haircut','₹200','30 min')">
        <div class="svc-name">Low Fade Haircut</div>
        <div class="svc-desc">Clean fade with a natural top. Timeless and sharp.</div>
        <div class="svc-meta"><span class="svc-price">₹200</span><span class="svc-dur">30 min</span></div>
      </div>
      <div class="svc-card" onclick="pickSvc(this,'High Fade + Design','₹280','40 min')">
        <div class="svc-name">High Fade + Design</div>
        <div class="svc-desc">Bold fade with a custom line design on the side.</div>
        <div class="svc-meta"><span class="svc-price">₹280</span><span class="svc-dur">40 min</span></div>
      </div>
      <div class="svc-card" onclick="pickSvc(this,'Full Beard Trim','₹150','20 min')">
        <div class="svc-name">Full Beard Trim</div>
        <div class="svc-desc">Shape, edge, and groom — razor finish included.</div>
        <div class="svc-meta"><span class="svc-price">₹150</span><span class="svc-dur">20 min</span></div>
      </div>
      <div class="svc-card" onclick="pickSvc(this,'Cut + Beard Combo','₹380','55 min')">
        <div class="svc-name">Cut + Beard Combo</div>
        <div class="svc-desc">The works — haircut and beard trim together.</div>
        <div class="svc-meta"><span class="svc-price">₹380</span><span class="svc-dur">55 min</span></div>
      </div>
      <div class="svc-card" onclick="pickSvc(this,'Kids Haircut','₹120','20 min')">
        <div class="svc-name">Kids Haircut</div>
        <div class="svc-desc">Fun and quick cut for children under 12.</div>
        <div class="svc-meta"><span class="svc-price">₹120</span><span class="svc-dur">20 min</span></div>
      </div>
      <div class="svc-card" onclick="pickSvc(this,'Head Massage + Cut','₹320','45 min')">
        <div class="svc-name">Head Massage + Cut</div>
        <div class="svc-desc">Relaxing massage followed by your preferred cut.</div>
        <div class="svc-meta"><span class="svc-price">₹320</span><span class="svc-dur">45 min</span></div>
      </div>
    </div>

    <div class="sec-div"></div>
    <p class="sec-label">Pick a date</p>
    <div class="date-row" id="dateRow"></div>

    <p class="sec-label">Pick a time</p>
    <div class="time-grid" id="timeGrid"></div>

    <div class="sec-div"></div>
    <p class="sec-label">Your details</p>
    <div class="form-grid">
      <div class="form-fld"><label>First Name</label><input type="text" id="bkFirst" placeholder="Raj"></div>
      <div class="form-fld"><label>Last Name</label><input type="text" id="bkLast" placeholder="Sharma"></div>
      <div class="form-fld"><label>Phone</label><input type="tel" id="bkPhone" placeholder="+91 98765 43210"></div>
      <div class="form-fld">
        <label>Barber preference</label>
        <select id="bkBarber">
          <option value="">No preference</option>
          <option>Arjun</option><option>Vikram</option><option>Suresh</option>
        </select>
      </div>
      <div class="form-fld full">
        <label>Special requests</label>
        <textarea id="bkNotes" placeholder="Any specific style, allergies, or notes..."></textarea>
      </div>
    </div>

    <div class="sum-box" id="sumBox">
      <div class="sum-row"><span>Service</span><span id="sumSvc">—</span></div>
      <div class="sum-row"><span>Date</span><span id="sumDate">—</span></div>
      <div class="sum-row"><span>Time</span><span id="sumTime">—</span></div>
      <div class="sum-row"><span>Duration</span><span id="sumDur">—</span></div>
      <div class="sum-total"><span>Total</span><span id="sumPrice">—</span></div>
    </div>

    <button class="confirm-btn" onclick="confirmBooking()">Confirm Booking →</button>
  </div>

  <div class="panel success-screen" id="successPanel">
    <div class="chk">✓</div>
    <h2>You're booked!</h2>
    <p id="successMsg">Your appointment is confirmed. See you soon!</p>
    <button class="ghost-btn" onclick="resetBooking()">Book another appointment</button>
  </div>
</div>

<script>
const DEMO={id:'raj@email.com',pw:'1234',first:'Raj',last:'Sharma',phone:'+91 98765 43210'};
let currentUser=null;

function goTo(page){
  document.querySelectorAll('.pg').forEach(p=>p.classList.remove('active'));
  document.getElementById(page==='login'?'pgLogin':'pgBook').classList.add('active');
  document.getElementById('navLoginBtn').style.display=page==='book'?'none':'inline-block';
  document.getElementById('navLogoutBtn').style.display=page==='book'?'inline-block':'none';
  window.scrollTo(0,0);
}

function switchTab(tab){
  const L=tab==='login';
  document.getElementById('tabLogin').classList.toggle('active',L);
  document.getElementById('tabSignup').classList.toggle('active',!L);
  document.getElementById('loginForm').style.display=L?'block':'none';
  document.getElementById('signupForm').style.display=L?'none':'block';
  document.getElementById('formTitle').textContent=L?'Welcome back':'Create account';
  document.getElementById('formSub').innerHTML=L
    ?'New here? <a onclick="switchTab(\'signup\')">Create an account</a>'
    :'Already registered? <a onclick="switchTab(\'login\')">Sign in</a>';
  document.getElementById('loginErr').classList.remove('show');
  document.getElementById('signupErr').classList.remove('show');
}

function doLogin(){
  const id=document.getElementById('loginId').value.trim();
  const pw=document.getElementById('loginPw').value;
  if(id===DEMO.id&&pw===DEMO.pw){currentUser=DEMO;enterBooking();}
  else document.getElementById('loginErr').classList.add('show');
}

function doSignup(){
  const f=document.getElementById('sgFirst').value.trim();
  const l=document.getElementById('sgLast').value.trim();
  const e=document.getElementById('sgEmail').value.trim();
  const p=document.getElementById('sgPhone').value.trim();
  const pw=document.getElementById('sgPw').value;
  const err=document.getElementById('signupErr');
  if(!f||!l||!e||!p||!pw){err.textContent='Please fill all fields.';err.classList.add('show');return;}
  if(pw.length<6){err.textContent='Password must be at least 6 characters.';err.classList.add('show');return;}
  currentUser={first:f,last:l,phone:p};
  enterBooking();
}

function guestLogin(){
  currentUser={first:'Guest',last:'',phone:''};
  enterBooking();
}

function enterBooking(){
  goTo('book');
  document.getElementById('userNameDisplay').textContent=currentUser.first;
  document.getElementById('userBar').classList.add('vis');
  if(currentUser.first)document.getElementById('bkFirst').value=currentUser.first;
  if(currentUser.last) document.getElementById('bkLast').value=currentUser.last;
  if(currentUser.phone)document.getElementById('bkPhone').value=currentUser.phone;
}

function logout(){
  currentUser=null;
  document.getElementById('userBar').classList.remove('vis');
  goTo('login');
  switchTab('login');
}

/* booking */
const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const TIMES=['9:00 AM','9:30 AM','10:00 AM','10:30 AM','11:00 AM','11:30 AM',
             '12:00 PM','2:00 PM','2:30 PM','3:00 PM','3:30 PM','4:00 PM',
             '4:30 PM','5:00 PM','5:30 PM','6:00 PM'];
const BOOKED=['10:30 AM','3:00 PM','5:00 PM'];
let chosen={svc:null,price:null,dur:null,date:null,time:null};

const dr=document.getElementById('dateRow');
const today=new Date();
for(let i=0;i<10;i++){
  const d=new Date(today);d.setDate(today.getDate()+i);
  const chip=document.createElement('div');
  chip.className='date-chip'+(i===0?' today':'');
  chip.innerHTML=`<span class="d-name">${DAYS[d.getDay()]}</span><span class="d-num">${d.getDate()}</span>`;
  chip.dataset.label=`${DAYS[d.getDay()]}, ${d.getDate()} ${MONTHS[d.getMonth()]}`;
  chip.onclick=()=>{
    document.querySelectorAll('.date-chip').forEach(c=>c.classList.remove('sel'));
    chip.classList.add('sel');chosen.date=chip.dataset.label;updateSum();setStep(2);
  };
  dr.appendChild(chip);
}

const tg=document.getElementById('timeGrid');
TIMES.forEach(t=>{
  const chip=document.createElement('div');
  chip.className='t-chip'+(BOOKED.includes(t)?' bkd':'');
  chip.textContent=t;
  if(!BOOKED.includes(t)){
    chip.onclick=()=>{
      document.querySelectorAll('.t-chip:not(.bkd)').forEach(c=>c.classList.remove('sel'));
      chip.classList.add('sel');chosen.time=t;updateSum();setStep(3);
    };
  }
  tg.appendChild(chip);
});

function pickSvc(el,name,price,dur){
  document.querySelectorAll('.svc-card').forEach(c=>c.classList.remove('sel'));
  el.classList.add('sel');
  chosen.svc=name;chosen.price=price;chosen.dur=dur;
  updateSum();setStep(1);
}

function updateSum(){
  if(chosen.svc&&chosen.date&&chosen.time){
    document.getElementById('sumSvc').textContent=chosen.svc;
    document.getElementById('sumDate').textContent=chosen.date;
    document.getElementById('sumTime').textContent=chosen.time;
    document.getElementById('sumDur').textContent=chosen.dur;
    document.getElementById('sumPrice').textContent=chosen.price;
    document.getElementById('sumBox').classList.add('vis');
  }
}

function setStep(n){
  for(let i=1;i<=3;i++){
    const el=document.getElementById('s'+i);
    el.classList.remove('active','done');
    if(i<n)el.classList.add('done');
    else if(i===n)el.classList.add('active');
  }
}

function confirmBooking(){
  const fn=document.getElementById('bkFirst').value.trim();
  const ph=document.getElementById('bkPhone').value.trim();
  if(!chosen.svc){alert('Please select a service.');return;}
  if(!chosen.date){alert('Please pick a date.');return;}
  if(!chosen.time){alert('Please pick a time slot.');return;}
  if(!fn){alert('Please enter your name.');return;}
  if(!ph){alert('Please enter your phone number.');return;}
  document.getElementById('bookPanel').style.display='none';
  document.getElementById('stepRow').style.opacity='0.3';
  const sc=document.getElementById('successPanel');
  sc.classList.add('vis');
  document.getElementById('successMsg').textContent=
    `${fn}, your ${chosen.svc} is confirmed for ${chosen.date} at ${chosen.time}. See you soon!`;
}

function resetBooking(){location.reload();}

goTo('login');
</script>
</body>
</html>